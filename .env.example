# Docker Compose interpolation settings.
#
# Copy this file to `.env`, replace every CHANGE_ME value with a unique random
# secret, and keep `.env` out of version control.  Application/LLM settings are
# loaded separately from APP_ENV_FILE at container runtime and are never copied
# into the image.
APP_ENV_FILE=./backend/.env
APP_UID=1000
APP_GID=1000

# The API and all infrastructure ports bind to loopback by default.  Set
# API_BIND_ADDRESS=0.0.0.0 only when a firewall or reverse proxy protects it.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8082
# API_SERVICE_ROLE 已随拆分移除:radai 仅运行智能体角色

MYSQL_DATABASE=document_processor
MYSQL_APP_USER=doc_agent
MYSQL_PASSWORD=CHANGE_ME_mysql_application_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

REDIS_PASSWORD=CHANGE_ME_redis_password

MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key_at_least_8_chars
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# Optional host-side port overrides.
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9093
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- omnigraph 知识服务接入(拆分后知识库独立部署) ----
# 智能体的知识库管理/检索请求经此地址代理与内部调用
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8086
# 与 omnigraph 侧保持一致的非空共享密钥(内部检索接口认证)
INTERNAL_API_SECRET=CHANGE_ME_internal_api_secret
# 知识库代理转发超时(秒)
KNOWLEDGE_PROXY_TIMEOUT_SECONDS=3600
