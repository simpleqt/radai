# ==============================================================================
# RADAI Application Environment Configuration Template
# Rename this file to .env and fill in the values before running the application.
# ==============================================================================

# --- Server Configurations ---
SERVER_HOST=your_server_host
SERVER_PORT=your_server_port
SERVER_RELOAD=true
CORS_ALLOWED_ORIGINS=your_allowed_origins

# --- LLM API Credentials & Base URLs ---
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_BASE=your_minimax_api_base

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=your_deepseek_api_base

GLM_API_KEY=your_glm_api_key
GLM_API_BASE=your_glm_api_base

QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=your_qwen_api_base

# --- SMS Service Gateway Configurations ---
SMS_GET_CHANNELS_URL=your_sms_get_channels_url
SMS_SEND_MESSAGE_URL=your_sms_send_message_url
SMS_KEY=your_sms_key
SMS_SECRET=your_sms_secret

# --- Storage Infrastructure (NebulaGraph, MySQL, Redis, MinIO) ---
NEBULA_HOST=your_nebula_host
NEBULA_PORT=your_nebula_port
NEBULA_USER=your_nebula_user
NEBULA_PASSWORD=your_nebula_password

MYSQL_HOST=your_mysql_host
MYSQL_PORT=your_mysql_port
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_mysql_database

REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

MINIO_ENDPOINT=your_minio_endpoint
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=your_minio_bucket_name
MINIO_PUBLIC_BASE_URL=your_minio_public_base_url
