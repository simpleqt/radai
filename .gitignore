# backend/scripts contains local operational state, but a small set of reusable
# source modules is versioned explicitly. Keep certificates, PID files and local
# one-off scripts out of Git by default.
backend/scripts/*
!backend/scripts/__init__.py
!backend/scripts/milvus_admin_common.py
!backend/scripts/openai_proxy_common.py
!backend/scripts/openai_proxy.py
!backend/scripts/openai_https_proxy.py
!backend/scripts/download_cdut_share.py
!backend/scripts/import_university_audit_kb.py
!backend/scripts/reingest_schema_misrouted_kbs.py

