[Unit]
Description=RADAI isolated test Git auto-update
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/home/inspur/myenv/runtime/doc-agent-test/source.git
ConditionPathIsSymbolicLink=/home/inspur/myenv/runtime/doc-agent-test/current

[Service]
Type=oneshot
WorkingDirectory=/home/inspur/myenv/runtime/doc-agent-test
Environment=DOC_AGENT_TEST_RUNTIME_ROOT=/home/inspur/myenv/runtime/doc-agent-test
Environment=DOC_AGENT_TEST_BRANCH=dev
Environment=DOC_AGENT_TEST_GIT_CREDENTIAL_FILE=/home/inspur/myenv/runtime/doc-agent-test/config/git-auth/credentials
Environment=DOC_AGENT_TEST_FAILURE_RETRY_SECONDS=3600
Environment=DOC_AGENT_TEST_AUTO_PROMOTE_PRODUCTION=false
ExecStart=/home/inspur/myenv/runtime/doc-agent-test/current/deploy/local-test/auto-update.sh
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
