[Unit]
Description=Document Agent Production FMCA Frontend (5176)
After=network-online.target doc-agent-prod-agent-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/inspur/myenv/runtime/doc-agent-production/current/frontend_fmca
Environment=VITE_API_PROXY_TARGET=http://127.0.0.1:8082
Environment=VITE_KNOWLEDGE_API_PROXY_TARGET=http://127.0.0.1:8086
Environment=VITE_API_FORWARDED_HOST=fmca.cdut.edu.cn
Environment=VITE_API_FORWARDED_PROTO=https
ExecStartPre=/usr/bin/test -x /home/inspur/myenv/runtime/doc-agent-production/current/frontend_fmca/node_modules/.bin/vite
ExecStart=/home/inspur/myenv/runtime/doc-agent-production/bin/run-frontend-dist.sh frontend_fmca 5176
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=doc-agent-prod-frontend-5176

[Install]
WantedBy=doc-agent-production.target
