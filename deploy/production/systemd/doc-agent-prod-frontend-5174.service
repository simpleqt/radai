[Unit]
Description=Document Agent Production CSH Frontend (5174)
After=network-online.target doc-agent-prod-agent-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/inspur/myenv/runtime/doc-agent-production/current/frontend_csh_ai
Environment=VITE_API_PROXY_TARGET=http://127.0.0.1:8082
Environment=VITE_KNOWLEDGE_API_PROXY_TARGET=http://127.0.0.1:8086
ExecStartPre=/usr/bin/test -x /home/inspur/myenv/runtime/doc-agent-production/current/frontend_csh_ai/node_modules/.bin/vite
ExecStart=/home/inspur/myenv/runtime/doc-agent-production/bin/run-frontend-dist.sh frontend_csh_ai 5174
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=doc-agent-prod-frontend-5174

[Install]
WantedBy=doc-agent-production.target
