[Unit]
Description=Document Agent Production Knowledge Ingest Worker
After=network-online.target doc-agent-prod-knowledge-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/inspur/myenv/runtime/doc-agent-production/current
EnvironmentFile=/home/inspur/myenv/runtime/doc-agent-production/config/service.env
Environment=LOG_SERVICE_NAME=ingest-worker
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=INGEST_WORKER_BATCH_SIZE=4
Environment=INGEST_WORKER_MAX_CONCURRENT_FILES=4
Environment=SELF_INGESTION_MINERU_MAX_CONCURRENCY=2
Environment=SELF_INGESTION_MINERU_LARGE_FILE_BYTES=268435456
Environment=SELF_INGESTION_MINERU_TIMEOUT=21600
Environment=SELF_INGESTION_IMAGE_MAX_BYTES=4194304
Environment=SELF_INGESTION_IMAGE_MAX_DIMENSION=2048
Environment=SELF_INGESTION_IMAGE_MAX_PIXELS=4000000
Environment=SELF_INGESTION_EMBEDDING_MAX_CONCURRENCY=70
Environment=SELF_INGESTION_MEDIA_EMBEDDING_MAX_CONCURRENCY=70
Environment=SELF_INGESTION_EMBEDDING_MIN_CONCURRENCY=1
Environment=SELF_INGESTION_EMBEDDING_BATCH_SIZE=32
Environment=SELF_INGESTION_EMBEDDING_TIMEOUT=120
Environment=SELF_INGESTION_EMBEDDING_MAX_RETRIES=3
Environment=SELF_INGESTION_REQUIRE_EMBEDDING=1
Environment=SELF_INGESTION_LLM_MAX_CONCURRENCY=70
Environment=SELF_INGESTION_GENERATION_MAX_CONCURRENCY=70
Environment=SELF_EXTRACTION_PER_DOC_BATCH_WINDOW=70
Environment=SELF_EXTRACTION_BATCH_RETRIES=0
Environment=SELF_EXTRACTION_FAILED_BATCH_RETRIES=1
Environment=SELF_EXTRACTION_BATCH_CHUNKS=4
Environment=SELF_EXTRACTION_ADAPTIVE_BATCHING=1
Environment=SELF_EXTRACTION_LLM_TIMEOUT=600
Environment=SELF_EXTRACTION_LLM_MAX_TOKENS=8192
Environment=SELF_INGESTION_VISION_MAX_CONCURRENCY=70
Environment=SELF_INGESTION_COMMIT_MYSQL_MAX_CONCURRENCY=1
Environment=SELF_INGESTION_COMMIT_MYSQL_RETRIES=8
Environment=SELF_INGESTION_COMMIT_MYSQL_RETRY_BASE_DELAY=1.0
Environment=SELF_EXTRACTION_MAX_BATCH_FAILURE_RATIO=0.25
Environment=SELF_INGESTION_NEBULA_INSERT_BATCH_SIZE=40
Environment=SELF_INGESTION_NEBULA_WRITE_WORKERS=1
Environment=MILVUS_INSERT_BATCH_SIZE=32
Environment=WORKER_SHUTDOWN_TIMEOUT_SECONDS=120
ExecStartPre=/usr/bin/test -x /home/inspur/myenv/runtime/doc-agent-production/current/.venv/bin/python
ExecStart=/home/inspur/myenv/runtime/doc-agent-production/current/.venv/bin/python -m backend.cli run-ingest-worker --workers 1
Restart=always
RestartSec=10s
KillMode=mixed
TimeoutStopSec=150s
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=doc-agent-prod-ingest-worker

[Install]
WantedBy=doc-agent-production.target
