[Unit]
Description=RADAI Docker primary-test Git auto-update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/inspur/myenv/runtime/doc-agent-docker-test/state/deployment.env

[Service]
Type=oneshot
WorkingDirectory=/home/inspur/myenv/runtime/doc-agent-docker-test
Environment=DOC_AGENT_DOCKER_TEST_ROOT=/home/inspur/myenv/runtime/doc-agent-docker-test
Environment=DOC_AGENT_HOST_TEST_ROOT=/home/inspur/myenv/runtime/doc-agent-test
Environment=DOC_AGENT_DOCKER_TEST_BRANCH=dev
Environment=DOC_AGENT_DOCKER_GIT_CREDENTIAL_FILE=/home/inspur/myenv/runtime/doc-agent-test/config/git-auth/credentials
Environment=DOC_AGENT_DOCKER_FAILURE_RETRY_SECONDS=3600
ExecStart=/home/inspur/myenv/runtime/doc-agent-docker-test/bin/auto-update.sh
TimeoutStartSec=60min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictRealtime=true
