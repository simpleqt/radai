server {
    listen 8080;
    server_name _;
    # Preserve relative redirects at the externally published host port. Without
    # this, nginx expands `return 302 /audit` with its internal port (8080),
    # which is unreachable from the browser through Docker's port mapping.
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 256m;
    set $agent_upstream http://agent-api:8082;
    set $knowledge_upstream http://knowledge-api:8086;
    set $files_upstream ${FILES_PROXY_TARGET};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-RADAI-Frontend-Mode audit always;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"alive","service":"university-audit-frontend"}';
    }

    location ~ ^/(?:@fs|@id|__vite_ping)(?:/|$) {
        return 403;
    }

    location = /knowledge-api {
        proxy_pass $knowledge_upstream/;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /knowledge-api/ {
        rewrite ^/knowledge-api/(.*)$ /$1 break;
        proxy_pass $knowledge_upstream$uri$is_args$args;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass $agent_upstream$request_uri;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /files/ {
        proxy_pass $files_upstream$request_uri;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        return 302 /audit;
    }

    # SPA fallbacks internally redirect here. Keep the document internal so a
    # direct /index.html request cannot bypass the audit-only route boundary.
    location = /index.html {
        internal;
        try_files /index.html =404;
    }

    location = /audit {
        try_files $uri /index.html;
    }

    location ^~ /audit/ {
        try_files $uri $uri/ /index.html;
    }

    location = /login {
        try_files $uri /index.html;
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location = /favicon.svg {
        try_files $uri =404;
    }

    location = /university-audit-logo.png {
        try_files $uri =404;
    }

    location / {
        return 302 /audit;
    }
}
