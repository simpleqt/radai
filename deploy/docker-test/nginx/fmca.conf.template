server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 256m;
    set $agent_upstream http://agent-api:8082;
    set $knowledge_upstream http://knowledge-api:8086;
    set $files_upstream ${FILES_PROXY_TARGET};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"alive","service":"radai-fmca-frontend"}';
    }

    location ~ ^/(?:@fs|@id|__vite_ping)(?:/|$) {
        return 403;
    }

    location = /knowledge-api {
        proxy_pass $knowledge_upstream/;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /knowledge-api/ {
        rewrite ^/knowledge-api/(.*)$ /$1 break;
        proxy_pass $knowledge_upstream$uri$is_args$args;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass $agent_upstream$request_uri;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host fmca.cdut.edu.cn;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /files/ {
        proxy_pass $files_upstream$request_uri;
        include /opt/radai-nginx/proxy-common.conf.template;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
