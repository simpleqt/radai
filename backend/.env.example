# LLM credentials referenced by backend/config.yaml.
# Copy these names into the deployment secret store or backend/.env; never
# commit real credential values.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
DASHSCOPE_API_KEY=
QWEN35_API_KEY=
QWEN35_API_BASE=

# Dedicated media/VL embedding service for image/table/formula retrieval.
MEDIA_EMBEDDING_ENABLED=
MEDIA_EMBEDDING_API_BASE=
MEDIA_EMBEDDING_API_KEY=
MEDIA_EMBEDDING_MODEL=Qwen3-VL-Embedding-8B
MEDIA_EMBEDDING_BATCH_SIZE=8

# School SMS gateway used by the main site register/reset-password flow.
SMS_SEND_MESSAGE_API_URL=
SMS_APP_ID=
SMS_APP_SECRET=
# Optional; current sender uses the default "sms" channel directly.
SMS_GET_CHANNELS_API_URL=

# CAS authentication. CAS_SERVICE_URL is an allowlist of public callback URLs
# (comma-separated for multi-frontend shared backends). Host/X-Forwarded-Host
# may only select among that allowlist; they never invent a new callback URL.
CAS_ENABLED=false
CAS_BASE_URL=
CAS_SERVICE_URL=https://app.example.com/api/v1/auth/cas/callback
CAS_FRONTEND_SUCCESS_URL=/login
CAS_FRONTEND_LOGOUT_REDIRECT=/login

# Keep enabled so a process crash between an administrative task retry and
# Kafka acknowledgement is reconciled from the database-backed outbox.
TASK_DISPATCH_OUTBOX_ENABLED=true
# Apply database backpressure instead of allowing an unbounded Kafka-outage
# backlog. Reconcilers use the normal polling interval with per-worker jitter.
OUTBOX_MAX_PENDING_EVENTS=10000

# SQLAlchemy pool settings are applied to both the sync and async MySQL
# engines. Per process, the upper bound is POOL_SIZE + MAX_OVERFLOW; multiply
# that by the number of API/worker processes and keep it below MySQL max_connections.
# The existing deployment baseline is 5 + 20. Increase these per process only
# after checking MySQL capacity and the number of workers.
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=20
# Fail fast instead of holding an HTTP request for SQLAlchemy's 30s default.
MYSQL_POOL_TIMEOUT_SECONDS=5

# Application Redis clients share one process-wide pool.  Keep the aggregate
# pool capacity across all API/worker processes below the Redis server limit.
REDIS_MAX_CONNECTIONS=200
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Pub/sub invalidation remains the fast path; this TTL heals a missed skill
# invalidation after a Redis disconnect.
AGENT_SKILL_CACHE_TTL_SECONDS=30

# Bound blocking storage work and MinIO network calls during shutdown/failure.
STORAGE_BLOCKING_TIMEOUT_SECONDS=120
STORAGE_CANCEL_DRAIN_TIMEOUT_SECONDS=5
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=60
MINIO_HTTP_POOL_COUNT=20
MINIO_HTTP_POOL_MAXSIZE=100

# Background runs and teardown paths are bounded so a stuck provider cannot
# permanently consume a runner slot or block response cleanup.
AGENT_BACKGROUND_EXECUTION_TIMEOUT_SECONDS=1800
SSE_PRODUCER_CLEANUP_TIMEOUT_SECONDS=5
AGENT_STREAM_ITERATOR_CLEANUP_TIMEOUT_SECONDS=5
AGENT_STREAM_DRAIN_TIMEOUT_SECONDS=15
AGENT_FINALIZER_TIMEOUT_SECONDS=15

# Enforce model/file ingestion limits across every worker with Redis leases.
SELF_INGESTION_DISTRIBUTED_CONCURRENCY=true
SELF_INGESTION_CONCURRENCY_NAMESPACE=self-ingestion-concurrency
SELF_INGESTION_CONCURRENCY_LEASE_TTL_SECONDS=120
SELF_INGESTION_CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=300
PENDING_INGEST_MAX_INLINE_TEXT_BYTES=67108864
SELF_INGESTION_MAX_IN_MEMORY_FILE_BYTES=134217728

# Shared Redis-backed HTTP admission limits.  The forwarded client IP is only
# trusted when the API is behind a configured trusted reverse proxy.
HTTP_AUTHENTICATED_RATE_LIMIT_PER_MINUTE=600
HTTP_ANONYMOUS_RATE_LIMIT_PER_MINUTE=120
HTTP_TRUST_FORWARDED_FOR=false

# Agent tree durability is opt-in. SQLite supports restart recovery on one
# host/shared volume; use "sql" with the shared MySQL pool for multi-host workers.
# Apply tracked migrations before enabling the SQL backend.
AGENT_RUNTIME_STORE_BACKEND=disabled
AGENT_RUNTIME_STORE_PATH=backend/.runtime/agent_runtime/agent_runtime.sqlite3

# LangGraph conversation checkpoints. The example uses Redis so multiple API
# workers share thread state; local development may explicitly select SQLite.
AGENT_CHECKPOINTER_BACKEND=redis
AGENT_CHECKPOINT_REDIS_PREFIX=agent-checkpoint

# Use redis in multi-worker deployments so all workers share the same fenced
# concurrency leases. The in-memory backend remains a safe local default.
AGENT_RESOURCE_LEASE_BACKEND=memory
AGENT_RESOURCE_LEASE_NAMESPACE=agent-runtime-lease
AGENT_RESOURCE_LEASE_TTL_SECONDS=30

# JSONL remains backward compatible. "indexed" stores searchable metadata in
# SQLite; "sql" reuses the shared MySQL pool for multi-worker indexes. Both
# move complete records to content-addressed local or MinIO blobs. Apply the
# tracked trace-index migration before enabling "sql".
AGENT_TRACE_BACKEND=jsonl
AGENT_TRACE_INDEXED_ROOT=backend/.runtime/agent_trace_index
AGENT_TRACE_BLOB_BACKEND=local
AGENT_TRACE_MINIO_BUCKET=
AGENT_TRACE_MINIO_PREFIX=agent-traces

# Optional shared request-tree runtime limits. Empty/unset means unlimited.
AGENT_TREE_MAX_TOKENS=
AGENT_TREE_MAX_TOOL_CALLS=
AGENT_TREE_MAX_ELAPSED_SECONDS=
AGENT_TREE_DEADLINE_AT=

# Public web search for agent research. The self-hosted Firecrawl deployment in
# deploy/firecrawl is the primary provider and returns cleaned page Markdown.
# No Firecrawl Cloud API key is required for this local deployment.
# All general web searches use the local Firecrawl service.
FIRECRAWL_API_URL=http://127.0.0.1:3002
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_LOCATION=China

# Deep research reviews its first evidence wave before writing and launches at
# most this many focused follow-up branches for material gaps.
COORDINATED_WORKFLOW_TOTAL_TIMEOUT_SECONDS=420
DEEP_RESEARCH_RESEARCH_PHASE_TIMEOUT_SECONDS=900
# Legacy finalization wait used by non-deep coordinated workflows.
DEEP_RESEARCH_PARTIAL_FINALIZATION_WAIT_SECONDS=60
# One branch may run for up to ten minutes, bounded again by the shared
# research-phase deadline.  Idle, search-count and model-turn guards normally
# stop stalled or looping branches much earlier.
DEEP_RESEARCH_BRANCH_TOTAL_TIMEOUT_SECONDS=600
# A deep-research branch may use the research phase's remaining time.  Once its
# bounded searches finish, reserve up to four minutes for evidence-only
# convergence; the research phase deadline and idle/turn/search guards still
# prevent loops.
DEEP_RESEARCH_BRANCH_CONVERGENCE_TIMEOUT_SECONDS=240
# Do not start a new branch when less than this remains in the research phase.
DEEP_RESEARCH_BRANCH_MIN_START_SECONDS=90
# The writer receives this fresh budget after research stops (minimum: 180s).
DEEP_RESEARCH_WRITER_TIMEOUT_SECONDS=300
# DOCX rendering, object upload and artifact registration use this budget only.
DEEP_RESEARCH_REPORT_TIMEOUT_SECONDS=120
DEEP_RESEARCH_REFLECTION_ROUNDS=1
DEEP_RESEARCH_FOLLOWUP_TASKS=2
DEEP_RESEARCH_STRUCTURED_OUTPUT_ATTEMPTS=2
DEEP_RESEARCH_FAST_MODEL_NAME=qwen3.6-35b
DEEP_RESEARCH_FAST_MODEL_MAX_BUDGET=1
